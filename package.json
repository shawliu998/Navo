{
  "name": "navo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "e2e": "pnpm --filter @navo/web e2e",
    "db:generate": "pnpm --filter @navo/db db:generate",
    "db:migrate": "pnpm --filter @navo/db db:migrate",
    "db:seed": "pnpm --filter @navo/db db:seed",
    "db:studio": "pnpm --filter @navo/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
