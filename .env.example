# Server-only database and queue configuration
DATABASE_URL=postgresql://exportplay:exportplay@localhost:54322/exportplay
REDIS_URL=redis://localhost:56379

# AI provider. "mock" is deterministic and used by tests.
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Sending is sandboxed by default.
EMAIL_PROVIDER=sink
EMAIL_TEST_MODE=true
EMAIL_TEST_ALLOWLIST=demo@navo.local
SESSION_SECRET=replace-with-a-long-random-value
