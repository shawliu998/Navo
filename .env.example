# Copy to .env.local automatically with `pnpm run bootstrap`.
# Existing .env.local files and credentials are never overwritten.

# Server-only database and queue configuration
DATABASE_URL=postgresql://navo:navo@localhost:54322/navo
REDIS_URL=redis://localhost:56379

# AI provider. "mock" is deterministic and used by tests.
# Keep Mock for the fastest zero-key golden-path run; switch to DeepSeek later.
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional local-development override. `pnpm dev` detects Codex-style synthetic
# 198.18/15 DNS automatically; literal benchmark IP URLs remain blocked.
WEBSITE_RESEARCH_ALLOW_BENCHMARK_DNS=

# Sending is sandboxed by default.
EMAIL_PROVIDER=sink
EMAIL_TEST_MODE=true
EMAIL_TEST_ALLOWLIST=demo@navo.local
SESSION_SECRET=replace-with-a-long-random-value
