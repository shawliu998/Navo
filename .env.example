# Copy to .env.local automatically with `pnpm run bootstrap`.
# Existing .env.local files and credentials are never overwritten.

# Server-only database and queue configuration
NAVO_POSTGRES_PORT=55432
NAVO_REDIS_PORT=56379
DATABASE_URL=postgresql://navo:navo@localhost:55432/navo
REDIS_URL=redis://localhost:56379

# AI provider. "mock" is deterministic and used by tests.
# Keep Mock for the fastest zero-key golden-path run; switch to DeepSeek later.
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional local-development override. `pnpm dev` detects Codex-style synthetic
# 198.18/15 DNS automatically; literal benchmark IP URLs remain blocked.
WEBSITE_RESEARCH_ALLOW_BENCHMARK_DNS=

# Sending is sandboxed by default.
EMAIL_PROVIDER=sink
EMAIL_TEST_MODE=true
EMAIL_TEST_ALLOWLIST=demo@navo.local

# Optional Resend inbound webhook integration. Set these to receive real
# email.received events from Resend. RESEND_WEBHOOK_SECRET verifies Svix
# signatures on POST /api/webhooks/resend/inbound. RESEND_API_KEY fetches
# the full received email in the worker before matching the outbound Navo
# message and creating a REPLY_FOLLOW_UP mission.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

SESSION_SECRET=replace-with-a-long-random-value
